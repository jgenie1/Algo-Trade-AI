rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Scoped access for ERP documents by userId
    match /erp/{userId} {
      // Allow read and write only for specific user documents, enforcing payload size & fields
      allow read, write: if userId.size() > 0 && userId.size() <= 64;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

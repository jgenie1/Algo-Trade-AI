# ==============================================================================
# ALGO-TRADE-AI - EXEMPLE DE CONFIGURATION DE L'ENVIRONNEMENT (HOSTINGER / LOCAL)
# ==============================================================================
# NOTE CONFIDENTIALITÉ :
# - Ne jamais commiter vos véritables clés dans Git.
# - En Production (Hostinger), renseignez ces variables dans le panneau Hostinger :
#   -> "hPanel" > "Node.js Application" > "Environment Variables" (ou dans le fichier .env sur VPS).

# ------------------------------------------------------------------------------
# 1. COINMARKETCAP API PRO (CONFIDENTIEL SERVEUR)
# Obtenez votre clé sur : https://pro.coinmarketcap.com/
# ------------------------------------------------------------------------------
COINMARKETCAP_API_KEY=VOTRE_CLE_COINMARKETCAP_PRO_ICI

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (ANALYSE DE MARCHÉ & AGENTS IA)
# Obtenez votre clé sur : https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=VOTRE_CLE_GEMINI_API_ICI

# ------------------------------------------------------------------------------
# 3. BLOCKCHAIN SOLANA (EXÉCUTION RÉELLE DES TRADES & BOTS)
# ------------------------------------------------------------------------------
SOLANA_PRIVATE_KEY=VOTRE_CLE_PRIVEE_SOLANA_BASE58_ICI
SOLANA_RPC_URL=https://rpc.ankr.com/solana
SOLANA_WSS_URL=wss://rpc.ankr.com/solana/ws

# ------------------------------------------------------------------------------
# 4. BLOCKCHAIN BINANCE SMART CHAIN & EVM (OPTIONNEL)
# ------------------------------------------------------------------------------
BSCSCAN_API_KEY=VOTRE_CLE_BSCSCAN_ICI
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ------------------------------------------------------------------------------
# 5. PUMP.FUN API (OPTIONNEL)
# ------------------------------------------------------------------------------
PUMPFUN_JWT_TOKEN=
PUMPFUN_API_URL=https://frontend-api-v3.pump.fun
